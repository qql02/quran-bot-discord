# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER upload `.env` anywhere public.
# On a panel host (bot-hosting.net…): create `.env` in the File Manager next to index.js.
# ───────────────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=            # Developer Portal → your app → Bot → Reset Token
CLIENT_ID=                # OPTIONAL — derived from DISCORD_TOKEN automatically; leave empty (only set it to double-check: a mismatch stops the bot)
MONGODB_URI=              # mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/quranbot  (MongoDB Atlas free tier works)

# ── Production ─────────────────────────────────────────────────────────────────
NODE_ENV=production
# At least 32 random characters (the bot refuses to start in production otherwise). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Owner dashboard (optional — the bot works without it) ──────────────────────
# Needs an HTTPS address that reaches this server, plus Redirect  <API_BASE_URL>/auth/discord/callback  in the Developer Portal.
ADMIN_IDS=                # your Discord user ID (comma-separated for several owners). Also required for the /test command.
MOD_IDS=                  # optional: moderators — a limited dashboard (view, voice control, remote play, per-server settings, message a server). No leave / blacklist / bulk / restart / logs / restrictions.
# OWNER_ALERT_DM=1        # 0 = never DM the owners (ADMIN_IDS) when a critical alert is confirmed (database down, Discord not ready, memory full …)
DISCORD_CLIENT_SECRET=    # Developer Portal → OAuth2 → Client Secret
API_BASE_URL=             # e.g. https://yourbot.example.com   (no trailing slash)
# API_PORT=               # the port is read from API_PORT, then PORT, then SERVER_PORT (panel hosts set SERVER_PORT for you)
# PORT=
# SERVER_PORT=
# ADMIN_DASHBOARD_URL=    # only when the dashboard files are hosted on another domain (default: <API_BASE_URL>/admin)

# ── Audio ──────────────────────────────────────────────────────────────────────
AUDIO_BACKEND=auto        # auto = ffmpeg if it works, otherwise the built-in WASM decoder · wasm = never use ffmpeg · ffmpeg = require it
# FFMPEG_PATH=
# STREAM_LOAD_TIMEOUT_MS=20000
# STREAM_STUCK_TIMEOUT_MS=25000

# ── Behaviour (all optional — these are the defaults) ──────────────────────────
# MAX_SESSIONS=                 # simultaneous voice sessions. Leave empty: computed from the RAM the host allows (1GB ≈ 14 with ffmpeg, up to 25). Raising it above that risks the host killing the bot
# AUTO_LEAVE_MINUTES=5          # leave after this long idle
# PAUSED_LEAVE_MINUTES=15
# EMPTY_LEAVE_SECONDS=30        # leave when the room is empty
# PULL_GRACE_SECONDS=90         # the last listener moved to another voice room: wait this long before leaving, so /pull can bring the recitation to them (0 = off)
# LEAVE_FOR_OTHER_BOTS=on       # on (default): leave at once when another bot joins our voice channel (no music over the Quran); off: stay
# DEFAULT_RECITER=Mishary Rashid Alafasy
# BOT_ACTIVITY=🕌 Reciting the Holy Quran
# BOT_PREFIX=!                  # prefix of the commands members type in the bot's private chat (e.g. !help, !page 45)
# BOT_THUMBNAIL_URL=            # default: the logo this server hosts at <API_BASE_URL>/assets/logo.png (needs an https API_BASE_URL)
# DONATION_URL=                 # https link for /donation (optional)
# INVITE_PERMISSIONS=37047312   # View, Send, Embed, Read History, External Emojis, Connect, Speak, Voice Activity, Manage Channels (for /setup). Old servers: re-open the new invite link to update.
# LOG_RETENTION_DAYS=7
# QURAN_CACHE_TTL_HOURS=6
# EXTRA_RECITER_SOURCES=on      # on | off — more complete reciters from a second source (QuranicAudio), checked in the background and cached for 7 days
# SECOND_BOT_TOKEN=          # token of a second, different Discord bot: the main bot then runs it from THIS project as the voice-only helper (its console lines are tagged [2nd-bot]); its ID also feeds the 🎧 button, so ALT_BOT_ID can stay empty
# ALT_BOT_ID=
# BOT_ROLE=primary             # primary | secondary — 'secondary' = the voice-only 2nd bot (same code, SAME MONGODB_URI): no slash commands, no scheduled posts, no dashboard. `npm run add-bot` writes its .env for you (see SETUP-HOST.md)
# DEPLOY_SCOPE=global           # where slash commands live — ONE place only: global (all servers) | guild (only GUILD_ID)
# GUILD_ID=                     # the mother server; required when DEPLOY_SCOPE=guild (instant updates, other servers get no commands)

# ── Verse of the day / Mushaf reader ───────────────────────────────────────────
# QURAN_API_URL=https://mp3quran.net/api/v3
# AYAH_API_URL=https://api.alquran.cloud/v1
# AYAH_TEXT_EDITION=quran-uthmani
# AYAH_TAFSIR_EDITION=ar.muyassar
# AYAH_API_TIMEOUT_MS=10000
# HADITH_API_URL=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1   # the six books for /hadith (one JSON file per hadith)
# HADITH_API_TIMEOUT_MS=10000

# ── Mushaf page images (Hafs + Warsh — King Fahd Complex artwork, served by quran.ws) ─────────────────────────────
# SVG pages are downloaded in the background at start-up (only the missing ones) into assets/quran-images/<riwaya>/NNN.svg,
# PNGs are rendered on demand. ~400MB of disk per riwaya. Off or failing = the text reader keeps working as before.
# MUSHAF_IMAGES=on                  # on | off
# MUSHAF_IMAGES_RIWAYAT=both        # both | hafs | warsh — fewer riwayat = less disk
# MUSHAF_IMAGES_PREFETCH=on         # on = download every missing page at start-up · off = only the pages members open
# MUSHAF_IMAGES_DIR=                # default <project>/assets/quran-images — use a persistent folder when the host wipes local files on restart
# MUSHAF_IMAGES_CDN=https://cdn.quran.ws/svg/pages/v1.1.1
# MUSHAF_IMAGES_CONCURRENCY=3       # parallel downloads (1-8)
# MUSHAF_IMAGE_WIDTH=1000           # width in pixels of the PNG shown in Discord (600-2000)

# ── API network hardening ──────────────────────────────────────────────────────
# API_HOST=0.0.0.0          # use 127.0.0.1 if a reverse proxy on the same machine is the only way in
# TRUST_PROXY=1             # number of reverse proxies in front of the API (0 = directly exposed: X-Forwarded-For is ignored)
# ⚠ With a direct-exposed port (no proxy) set TRUST_PROXY=0, otherwise X-Forwarded-For can be forged to bypass rate limits.
#   BUT if the dashboard is reached through an https domain / panel proxy (API_BASE_URL=https://…), keep TRUST_PROXY=1:
#   with 0 the Secure session cookie is never set behind a TLS-terminating proxy and dashboard sign-in fails.
# SESSION_DAYS=2           # dashboard login lifetime in days (sliding, 1-30)
# AUDIO_ALLOW_HLS=1         # only if you need .m3u8 stations: ffmpeg then opens them itself (weaker SSRF protection)

# ── Never set this in production ───────────────────────────────────────────────
# AUDIO_ALLOW_PRIVATE=1         # switches OFF the protection against stations pointing at internal addresses

# Memory guard (index.js): clean RAM every GC_INTERVAL_SEC seconds when above GC_LIMIT_MB (0 = off)
# GC_LIMIT_MB=300
# GC_INTERVAL_SEC=15
